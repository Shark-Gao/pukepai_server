# Render服务器环境变量配置
# 将此文件内容复制到Render的Environment Variables中

# 服务器配置
NODE_ENV=production
PORT=10000

# 数据库配置（使用Render PostgreSQL或外部MySQL）
# 如果使用Render PostgreSQL：
DB_HOST=your-render-postgres-host
DB_PORT=5432
DB_NAME=doudizhu_game
DB_USER=your-username
DB_PASSWORD=your-password

# 如果使用外部MySQL：
# DB_HOST=your-mysql-host
# DB_PORT=3306
# DB_NAME=doudizhu_game
# DB_USER=your-username
# DB_PASSWORD=your-password

# JWT配置（如果需要）
JWT_SECRET=your-jwt-secret-key

# 微信小程序配置（如果需要）
WX_APP_ID=your-wechat-app-id
WX_APP_SECRET=your-wechat-app-secret

# 静态资源URL（用于客户端访问）
RESOURCE_BASE_URL=https://your-render-domain.onrender.com/static